{
  "id": "workflow-generator",
  "name": "Gerador de Workflow",
  "description": "Gera workflows customizados: ChatInputNode (demanda) → APINode (cria) → AgentNode (analisa) → OutputNode (resultado)",
  "graph": {
    "nodes": [
      {
        "id": "chat-input",
        "type": "chatInput",
        "position": { "x": 50, "y": 100 },
        "data": { "label": "Demanda" }
      },
      {
        "id": "api-create-demand",
        "type": "api",
        "position": { "x": 250, "y": 100 },
        "data": {
          "label": "Criar Demanda",
