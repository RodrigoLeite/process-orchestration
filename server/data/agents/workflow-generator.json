        }
      }
    ],
    "edges": [
      { "source": "chat-input", "target": "api-create-demand", "id": "e1" },
      { "source": "api-create-demand", "target": "agent-generate-workflow", "id": "e2" },
      { "source": "agent-generate-workflow", "target": "output-workflow", "id": "e3" }
    ],
    "viewport": { "x": 0, "y": 0, "zoom": 1 }
