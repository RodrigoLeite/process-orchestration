modules = ["nodejs-20", "web", "postgresql-16"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 35023
externalPort = 3001

[[ports]]
localPort = 37257
externalPort = 8000

[[ports]]
localPort = 37677
externalPort = 4200

[[ports]]
localPort = 37879
externalPort = 8081

[[ports]]
localPort = 39333
externalPort = 3003

[[ports]]
localPort = 39599
externalPort = 3002

[[ports]]
localPort = 40099
externalPort = 5000

[[ports]]
localPort = 40653
externalPort = 6000

[[ports]]
localPort = 41211
externalPort = 5173

[[ports]]
localPort = 41527
externalPort = 8080

[[ports]]
localPort = 41929
externalPort = 8008

[[ports]]
localPort = 44833
externalPort = 6800

[env]
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
mockupState = "FULLSTACK"

[userenv]

[userenv.shared]
LANGSMITH_PROJECT = "process-orchestration"
LANGSMITH_ENDPOINT = "https://api.smith.langchain.com"
LANGSMITH_ENABLED = "true"

[userenv.development]
GOOGLE_CALLBACK_URL_DEV = "https://6223e777-ce20-4af3-8c51-b6d90edd3134-00-nvajlv5o7d7z.riker.replit.dev/api/auth/google/callback"
